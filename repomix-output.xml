@import "tailwindcss";
@import "tw-animate-css";
@import "shadcn/tailwind.css";

@custom-variant dark (&:is(.dark *));

:root {
  /* ---- Light mode palette ----
     Base is a soft mint/paper white with a deep-forest ink for text.
     River (teal) is the primary interactive accent, brass (purple) and
     lime stay as secondary accent colors for gradients/blobs/badges. */
  --color-paper: #F1FAF6;
  --color-surface: #FFFFFF;
  --color-ink: #0D2B22;
  --color-moss: #5E7A6E;
  --color-forest: #0F3D2E;
  --color-forest-hover: #155A41;
  --color-river: #14B8A6;
  --color-brass: #8B5CF6;
  --color-lime: #65C466;
  --color-rust: #E4574B;
  --color-border: rgba(15, 61, 46, 0.12);

  /* Signature 3-stop gradient — used for the gradient-text utility below
     and available as a background for special CTAs/badges. Keep it off
     ordinary button backgrounds; on a lime-heavy gradient, text contrast
     gets uneven, so solid single-color buttons stay more legible. */
  --gradient-brand: linear-gradient(90deg, #A3E635 0%, #2DD4BF 50%, #8B5CF6 100%);

  /* Soft page-wide gradient — a gentle diagonal wash built from the
     existing palette tokens so it automatically follows theme changes
     (including dark mode) without needing a second definition. */
  --gradient-page: linear-gradient(
    160deg,
    var(--color-paper) 0%,
    color-mix(in oklab, var(--color-paper), var(--color-river) 10%) 45%,
    color-mix(in oklab, var(--color-paper), var(--color-brass) 8%) 100%
  );

  --font-display: 'Fraunces', serif;
  --font-body: 'Inter', system-ui, sans-serif;
  --font-mono: 'IBM Plex Mono', monospace;

  --radius: 1rem;
  --shadow-sm: 0 1px 2px rgba(15, 61, 46, 0.08);
  --shadow-md: 0 8px 24px rgba(15, 61, 46, 0.12);
  --shadow-lg: 0 16px 40px rgba(15, 61, 46, 0.16);

  /* ---- shadcn semantic tokens, remapped onto the palette above ---- */
  --background: var(--color-paper);
  --foreground: var(--color-ink);

  --card: var(--color-surface);
  --card-foreground: var(--color-ink);

  --popover: var(--color-surface);
  --popover-foreground: var(--color-ink);

  --primary: var(--color-forest);
  --primary-foreground: #F4FBF7;

  --secondary: var(--color-river);
  --secondary-foreground: #05261F;

  --muted: rgba(15, 61, 46, 0.06);
  --muted-foreground: var(--color-moss);

  --accent: var(--color-brass);
  --accent-foreground: #FFFFFF;

  --destructive: var(--color-rust);
  --destructive-foreground: #FFFFFF;

  --border: var(--color-border);
  --input: var(--color-border);
  --ring: var(--color-river);

  /* Left as shadcn defaults — unused until charts/sidebar nav are added */
  --chart-1: oklch(0.868 0.007 39.5);
  --chart-2: oklch(0.547 0.021 43.1);
  --chart-3: oklch(0.438 0.017 39.3);
  --chart-4: oklch(0.367 0.016 35.7);
  --chart-5: oklch(0.268 0.011 36.5);
  --sidebar: var(--color-surface);
  --sidebar-foreground: var(--color-ink);
  --sidebar-primary: var(--color-forest);
  --sidebar-primary-foreground: #F4FBF7;
  --sidebar-accent: rgba(15, 61, 46, 0.06);
  --sidebar-accent-foreground: var(--color-ink);
  --sidebar-border: var(--color-border);
  --sidebar-ring: var(--color-river);
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  background: var(--gradient-page);
  background-attachment: fixed;
  color: var(--color-ink);
  font-family: var(--font-body);
  font-size: 15px;
  line-height: 1.5;
}

h1, h2, h3 {
  font-family: var(--font-display);
  font-weight: 600;
  margin: 0 0 0.5rem;
}

.wordmark {
  font-family: var(--font-display);
  font-style: italic;
  font-weight: 600;
  color: var(--color-forest);
  text-decoration: none;
}
.wordmark span {
  margin-left: -0.05em;
}
.cast-divider {
  display: block;
  margin: 0.25rem 0 0.75rem;
}
a {
  /* Links inherit whatever text color their container sets (usually the
     ink color) instead of always turning river/teal. Components that
     want an accent-colored link can still set that explicitly. */
  color: inherit;
}

label {
  display: block;
  font-size: 0.85rem;
  font-weight: 500;
  color: var(--color-moss);
  margin-bottom: 0.35rem;
}

.text-mono {
  font-family: var(--font-mono);
}

/* Animated ambient gradient background — three drifting radial blobs in the
   brand colors, tuned for a light paper base. Applied to the landing page
   hero; drop it on any full-bleed section that should feel "alive." */
@keyframes gradient-drift {
  0% { background-position: 0% 50%, 100% 50%, 50% 100%; }
  50% { background-position: 100% 50%, 0% 50%, 50% 0%; }
  100% { background-position: 0% 50%, 100% 50%, 50% 100%; }
}

.animated-gradient-bg {
  background-color: var(--color-paper);
  background-image:
    radial-gradient(circle at 20% 20%, rgba(163, 230, 53, 0.20), transparent 45%),
    radial-gradient(circle at 80% 25%, rgba(139, 92, 246, 0.16), transparent 48%),
    radial-gradient(circle at 50% 85%, rgba(20, 184, 166, 0.20), transparent 48%);
  background-size: 180% 180%, 180% 180%, 180% 180%;
  animation: gradient-drift 20s ease infinite;
}

/* Gradient text — used on the "story." highlight word on the landing page. */
.gradient-text {
  background-image: var(--gradient-brand);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

@media (prefers-reduced-motion: reduce) {
  * { transition: none !important; }
  .animated-gradient-bg { animation: none !important; }
}

.dark {
  /* Previous dark-mode palette, kept here so a future light/dark toggle
     has a real dark theme to fall back to instead of shadcn's defaults. */
  --color-paper: #070F0C;
